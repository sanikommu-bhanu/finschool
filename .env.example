# Firebase project config — get these from Firebase Console
# Project Settings > General > Your apps > Web app > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — only needed if you enable Google Analytics on the Firebase project
VITE_FIREBASE_MEASUREMENT_ID=

# xAI Grok API key — free tier available at https://console.x.ai — powers the AI Financial Assistant.
# NOT a client env var: the key is proxied server-side by the `askGrok` Cloud Function
# (functions/src/index.ts) so it never ships in the browser bundle. Set it with:
#   firebase functions:secrets:set GROK_API_KEY
# Optional — override the Grok model slug (defaults to grok-4.3): add GROK_MODEL=<slug>
# to functions/.env before deploying.

