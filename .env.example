# Firebase project config — get these from Firebase Console
# Project Settings > General > Your apps > Web app > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — only needed if you enable Google Analytics on the Firebase project
VITE_FIREBASE_MEASUREMENT_ID=

# xAI Grok API key — free tier available at https://console.x.ai — powers the AI Financial Assistant
VITE_GROK_API_KEY=your_api_key_here
# Optional — override the Grok model slug (defaults to grok-4.3 in code)
VITE_GROK_MODEL=llama-3.3-70b-versatile

